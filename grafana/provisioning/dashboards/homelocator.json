{
  "title": "HomeLocator",
  "uid": "homelocator-main",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-24h", "to": "now" },
  "timepicker": {},
  "tags": ["homelocator"],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Page Loads (24h)",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["sum"] },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "blue" },
          "unit": "short"
        }
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "increase(homelocator_page_loads_total[24h])",
          "instant": true,
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Searches (24h)",
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["sum"] },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "green" },
          "unit": "short"
        }
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "increase(homelocator_searches_total[24h])",
          "instant": true,
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Map Clicks (24h)",
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["sum"] },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "orange" },
          "unit": "short"
        }
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(increase(homelocator_map_clicks_total[24h]))",
          "instant": true,
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "HTTP Requests (24h)",
      "gridPos": { "x": 12, "y": 0, "w": 4, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["sum"] },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "purple" },
          "unit": "short"
        }
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(increase(http_requests_received_total{job=\"homelocator\"}[24h]))",
          "instant": true,
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "HTTP Error Rate (24h)",
      "gridPos": { "x": 16, "y": 0, "w": 4, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["sum"] },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "red", "value": 50 }
            ]
          },
          "unit": "short"
        }
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(increase(http_requests_received_total{job=\"homelocator\", code=~\"5..\"}[24h]))",
          "instant": true,
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Page Loads & Searches Over Time",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "lineWidth": 2 } }
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "rate(homelocator_page_loads_total[5m]) * 60",
          "legendFormat": "Page Loads / min"
        },
        {
          "datasource": "Prometheus",
          "expr": "rate(homelocator_searches_total[5m]) * 60",
          "legendFormat": "Searches / min"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Map Button Clicks Over Time",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "lineWidth": 2 } }
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "rate(homelocator_map_clicks_total{map=\"google\"}[5m]) * 60",
          "legendFormat": "Google Maps / min"
        },
        {
          "datasource": "Prometheus",
          "expr": "rate(homelocator_map_clicks_total{map=\"osm\"}[5m]) * 60",
          "legendFormat": "OpenStreetMap / min"
        },
        {
          "datasource": "Prometheus",
          "expr": "rate(homelocator_map_clicks_total{map=\"laerm\"}[5m]) * 60",
          "legendFormat": "Lärmkarte / min"
        },
        {
          "datasource": "Prometheus",
          "expr": "rate(homelocator_map_clicks_total{map=\"hochwasser\"}[5m]) * 60",
          "legendFormat": "Hochwasser / min"
        }
      ]
    },
    {
      "id": 8,
      "type": "piechart",
      "title": "Map Button Clicks Breakdown",
      "gridPos": { "x": 0, "y": 12, "w": 8, "h": 8 },
      "options": {
        "pieType": "donut",
        "legend": { "displayMode": "list", "placement": "right" },
        "tooltip": { "mode": "single" }
      },
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum by (map) (increase(homelocator_map_clicks_total[24h]))",
          "instant": true,
          "legendFormat": "{{map}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "HTTP Request Rate by Status Code",
      "gridPos": { "x": 8, "y": 12, "w": 16, "h": 8 },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "lineWidth": 2 }
        }
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum by (code) (rate(http_requests_received_total{job=\"homelocator\"}[5m]))",
          "legendFormat": "HTTP {{code}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "HTTP Request Duration (p50 / p95 / p99)",
      "gridPos": { "x": 0, "y": 20, "w": 24, "h": 8 },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "lineWidth": 2 }
        }
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"homelocator\"}[5m])))",
          "legendFormat": "p50"
        },
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"homelocator\"}[5m])))",
          "legendFormat": "p95"
        },
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"homelocator\"}[5m])))",
          "legendFormat": "p99"
        }
      ]
    }
  ]
}
