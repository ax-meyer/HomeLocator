# Copy this file to .env and fill in real values before running
# `docker compose up -d` with docker-compose.yml.
#
# docker-compose.dev.yml (local Postgres only, for `dotnet run`) does not
# need this file — it uses a hardcoded dev password.

# Password for the "homelocator" Postgres user, shared by the app and db services.
DB_PASSWORD=changeme

# Public hostname Traefik should route to this app, e.g. grundstuecke.example.com.
DOMAIN=grundstuecke.example.com

# GitHub user/org that owns the ghcr.io image, e.g. ghcr.io/<owner>/grundstuecksfinder.
GITHUB_REPOSITORY_OWNER=your-github-username

# Optional: password for the self-hosted Nominatim's internal Postgres. It's only
# reachable inside the Nominatim container, so the default "nominatim" is fine.
# NOMINATIM_PASSWORD=nominatim

# Optional Nominatim sizing — defaults fit a 16 GB server with ~10 GB free. On a bigger
# or emptier machine, raise the cap and memory settings for a faster import.
# NOMINATIM_MEM_LIMIT=9g
# NOMINATIM_THREADS=4
# NOMINATIM_SHM_SIZE=1g
# NOMINATIM_SHARED_BUFFERS=1GB
# NOMINATIM_MAINTENANCE_WORK_MEM=1GB
# NOMINATIM_AUTOVACUUM_WORK_MEM=256MB
# NOMINATIM_EFFECTIVE_CACHE_SIZE=4GB
