<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsPackable>false</IsPackable>
        <!-- xUnit v3 test projects are self-executing: the runner is compiled in
             rather than supplied by an external VSTest host. -->
        <OutputType>Exe</OutputType>
        <!-- Generate a Microsoft.Testing.Platform entry point instead of xUnit's
             own in-process console runner. Pairs with the test.runner setting in
             global.json, which points "dotnet test" at MTP. -->
        <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="FakeItEasy" Version="9.0.1" />
        <PackageReference Include="FluentAssertions" Version="8.10.0" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.11" />
        <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.11" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
        <PackageReference Include="Testcontainers.PostgreSql" Version="4.15.0" />
        <!-- The "mtp-v2" variant pins Microsoft.Testing.Platform v2; the plain
             xunit.v3 metapackage would pull MTP v1 instead. -->
        <PackageReference Include="xunit.v3.mtp-v2" Version="3.2.2" />
        <!-- Supplies the TRX report option used by CI. -->
        <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" Version="2.4.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Grundstuecksfinder\Grundstuecksfinder.csproj" />
    </ItemGroup>

    <!-- Include part.csv as test data -->
    <ItemGroup>
        <Content Include="../part.csv">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <Link>TestData/part.csv</Link>
        </Content>
    </ItemGroup>

</Project>
