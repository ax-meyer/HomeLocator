{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=homelocator;Username=homelocator;Password=changeme"
  },
  "Import": {
    "Nrw": {
      "ManifestUrl": "https://www.opengeodata.nrw.de/produkte/infrastruktur_bauen_wohnen/grundsteuer/index.json",
      "BaseDownloadUrl": "https://www.opengeodata.nrw.de/produkte/infrastruktur_bauen_wohnen/grundsteuer/"
    },
    "Inspire": {
      "Sources": [
        {
          "Source": "sh",
          "Enabled": true,
          "DatasetName": "sh-alkis",
          "ParcelWfsUrl": "https://service.gdi-sh.de/SH_INSPIREDOWNLOAD_AI_CP_ALKIS",
          "AddressWfsUrl": "https://service.gdi-sh.de/SH_INSPIREDOWNLOAD_AI_AD",
          "Crs": "http://www.opengis.net/def/crs/epsg/0/25832",
          "BoundingBox": { "MinX": 400000, "MinY": 5900000, "MaxX": 660000, "MaxY": 6120000 },
          "TileSizeMeters": 5000
        }
      ]
    }
  },
  "Geocoding": {
    "NominatimBaseUrl": "https://nominatim.openstreetmap.org/"
  },
  "AllowedHosts": "*",
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Day"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  }
}
