@code {
    private IReadOnlyDictionary<string, int> _retrievalYears = new Dictionary<string, int>();

    protected override async Task OnInitializedAsync()
    {
        // The Impressum must render even with the database down; the years then fall back below.
        try
        {
            _retrievalYears = await PropertyService.GetRetrievalYearsAsync();
        }
        catch (Exception)
        {
        }
    }

    /// <summary>
    /// The "Jahr des Datenbezugs" a credit must name: when the served data was fetched, or this
    /// year when there is none yet (the first import is running or about to).
    /// </summary>
    private int RetrievalYear(string source) =>
        _retrievalYears.TryGetValue(source, out var year) ? year : TimeProvider.GetLocalNow().Year;
}
