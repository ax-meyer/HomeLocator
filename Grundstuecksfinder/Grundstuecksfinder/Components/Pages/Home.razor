@page "/"
@inject PropertyService PropertyService
@inject FilterOptionsService FilterOptionsService
@inject GeocodingService GeocodingService
@inject AppMetrics AppMetrics
@inject SupportedStates SupportedStates
@using Grundstuecksfinder.Services
@using Grundstuecksfinder.Models

<PageTitle>Grundstücksfinder</PageTitle>

<h1 class="mb-1">Grundstücksfinder</h1>
<p class="text-muted @(SupportedStates.Names.Count > 0 ? "mb-1" : "mb-3")">
    Finde die Adresse eines Grundstücks oder Hauses anhand von PLZ / Gemeinde und Grundstücksgröße.
</p>
@if (SupportedStates.Names.Count > 0)
{
    <p class="text-muted mb-3">Verfügbar für: @string.Join(", ", SupportedStates.Names)</p>
}

@if (_lastCheckedAt == null)
{
    <div class="alert alert-warning mb-3">
        <strong>Noch keine Daten importiert.</strong>
        Der erste Import startet automatisch mit der Anwendung und kann einige Stunden dauern.
    </div>
}
else
{
    <p class="text-muted small mb-3">
        Stand: @_lastCheckedAt.Value.ToLocalTime().ToString("dd.MM.yyyy, HH:mm") Uhr
        · @_totalCount.ToString("N0") Einträge
    </p>
}

<div class="row g-3 mb-4 align-items-end">
    <div class="col-sm-6 col-md-3">
        <RadzenLabel Text="PLZ" />
        <RadzenDropDown @bind-Value="_plz" @bind-Value:after="OnLocationChanged" Data="@_plzOptions"
                        AllowFiltering="true" AllowClear="true" AllowVirtualization="true"
                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                        Placeholder="PLZ wählen …" class="w-100" />
    </div>
    <div class="col-sm-6 col-md-3">
        <RadzenLabel Text="Gemeinde" />
        <RadzenDropDown @bind-Value="_gemeinde" @bind-Value:after="OnLocationChanged" Data="@_gemeindeOptions"
                        AllowFiltering="true" AllowClear="true" AllowVirtualization="true"
                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                        Placeholder="Gemeinde wählen …" class="w-100" />
    </div>
    <div class="col-sm-6 col-md-2">
        <RadzenLabel Text="Fläche min (m²)" />
        <RadzenNumeric @bind-Value="_minFlaeche" class="w-100" TValue="double?" />
    </div>
    <div class="col-sm-6 col-md-2">
        <RadzenLabel Text="Fläche max (m²)" />
        <RadzenNumeric @bind-Value="_maxFlaeche" class="w-100" TValue="double?" />
    </div>
    <div class="col-sm-12 col-md-2">
        <RadzenButton Text="Suchen" Click="Search"
                      ButtonStyle="ButtonStyle.Primary" class="w-100"
                      IsBusy="_loading" BusyText="Suche läuft …" />
    </div>
</div>

@if (_searched)
{
    @if (_properties.Count == 0)
    {
        <p class="text-muted">Keine Grundstücke gefunden.</p>
    }
    else
    {
        <p class="text-muted">
            @_properties.Count Ergebnis@(_properties.Count == 1 ? "" : "se")
            @if (_properties.Count == MaxResults)
            {
                <span> – Anzeige auf @MaxResults begrenzt. Bitte Filter eingrenzen.</span>
            }
        </p>

        <RadzenDataGrid TItem="Property" Data="@_properties"
                        AllowFiltering="true" AllowSorting="true"
                        AllowPaging="true" PageSize="25"
                        RowExpand="@OnRowExpand">
            <Template Context="property">
                <PropertyDetail Property="property" Coords="_coords.GetValueOrDefault(property.Id)" />
            </Template>
            <Columns>
                <RadzenDataGridColumn TItem="Property" Property="Str"         Title="Straße" />
                <RadzenDataGridColumn TItem="Property" Property="Hnr"         Title="Nr."      Width="70px" />
                <RadzenDataGridColumn TItem="Property" Property="HnrZus"      Title="Zusatz"   Width="80px" />
                <RadzenDataGridColumn TItem="Property" Property="Plz"         Title="PLZ"      Width="80px" />
                <RadzenDataGridColumn TItem="Property" Property="Ort"         Title="Ort" />
                <RadzenDataGridColumn TItem="Property" Property="Gemeinde"    Title="Gemeinde" />
                <RadzenDataGridColumn TItem="Property" Property="FlaecheAmtl" Title="Fläche (m²)" Width="120px" />
            </Columns>
        </RadzenDataGrid>
    }
}
else if (_searchRequested)
{
    <p class="text-muted">Bitte wähle zuerst eine PLZ oder Gemeinde.</p>
}
else
{
    <p class="text-muted">Wähle eine PLZ oder Gemeinde und klicke auf <strong>Suchen</strong>.</p>
}

@code {
    private const int MaxResults = 500;

    private string? _plz;
    private string? _gemeinde;
    private double? _minFlaeche;
    private double? _maxFlaeche;
    private List<Property> _properties = [];
    private bool _searched;
    private bool _loading;
    // Suchen was clicked without a PLZ/Gemeinde; search as soon as one is chosen.
    private bool _searchRequested;
    // A filter changed while a search was running.
    private bool _rerunSearch;
    private DateTimeOffset? _lastCheckedAt;
    private long _totalCount;
    private DateTimeOffset _lastSearchAt = DateTimeOffset.MinValue;

    private IReadOnlyList<string> _plzOptions = [];
    private IReadOnlyList<string> _gemeindeOptions = [];

    // propertyId → (lat, lon)
    private readonly Dictionary<int, (double Lat, double Lon)> _coords = [];

    protected override async Task OnInitializedAsync()
    {
        _lastCheckedAt = await PropertyService.GetLastCheckedAtAsync();
        _totalCount = await PropertyService.GetTotalPropertyCountAsync();
        var filterOptions = await FilterOptionsService.GetAsync();
        _plzOptions = filterOptions.Plz;
        _gemeindeOptions = filterOptions.Gemeinden;
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            AppMetrics.RecordPageLoad();
        return Task.CompletedTask;
    }

    private async Task Search()
    {
        if (DateTimeOffset.UtcNow - _lastSearchAt < TimeSpan.FromSeconds(1))
            return;

        _lastSearchAt = DateTimeOffset.UtcNow;
        await RunSearch();
    }

    // RadzenDropDown sets its value only after closing the popup (a JS round trip), so a
    // click on Suchen right after picking an item can run before the value arrives. Re-running
    // the search when the value lands keeps the results in line with the visible filters.
    private Task OnLocationChanged() =>
        _searched || _searchRequested ? RunSearch() : Task.CompletedTask;

    private async Task RunSearch()
    {
        if (_loading)
        {
            _rerunSearch = true;
            return;
        }

        _loading = true;
        try
        {
            do
            {
                _rerunSearch = false;
                if (string.IsNullOrEmpty(_plz) && string.IsNullOrEmpty(_gemeinde))
                {
                    _searchRequested = true;
                    _searched = false;
                    _properties = [];
                    return;
                }

                _searchRequested = false;
                _coords.Clear();
                AppMetrics.RecordSearch();
                _properties = await PropertyService.GetPropertiesAsync(_gemeinde, _plz, _minFlaeche, _maxFlaeche, MaxResults);
                _searched = true;
            } while (_rerunSearch);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnRowExpand(Property property)
    {
        AppMetrics.RecordTableRowOpen();
        if (_coords.ContainsKey(property.Id)) return;
        var coords = await GeocodingService.GeocodeAsync(property);
        if (coords.HasValue)
        {
            _coords[property.Id] = coords.Value;
            StateHasChanged();
        }
    }
}
