@using Grundstuecksfinder.Models
@using Grundstuecksfinder.Services
@inject AppMetrics AppMetrics
@inject IJSRuntime JS

@* Inline expansion panel shown below a clicked result row. *@

<div class="p-3 bg-body-tertiary border-top">
    <div class="row g-3">

        @* ── Links ────────────────────────────────────────────────────────── *@
        <div class="col d-flex flex-column gap-2">
            <h6 class="mb-2">Karten &amp; Informationen</h6>

            <a href="@GoogleMapsUrl" target="_blank" rel="noopener" class="btn btn-sm btn-outline-secondary d-inline-flex justify-content-center align-items-center gap-1"
               @onclick="ClickGoogle">
                Google Maps
                @ExternalLinkIcon
            </a>
            <a href="@OsmUrl" target="_blank" rel="noopener" class="btn btn-sm btn-outline-secondary d-inline-flex justify-content-center align-items-center gap-1"
               @onclick="ClickOsm">
                OpenStreetMap
                @ExternalLinkIcon
            </a>
            @if (LaermUrl is not null)
            {
                <a href="@LaermUrl" target="_blank" rel="noopener" class="btn btn-sm btn-outline-secondary d-inline-flex justify-content-center align-items-center gap-1"
                   @onclick="ClickLaerm">
                    Lärmkarte
                    @ExternalLinkIcon
                </a>
            }
            @if (HochwasserUrl is not null)
            {
                <a href="@HochwasserUrl" target="_blank" rel="noopener" class="btn btn-sm btn-outline-secondary d-inline-flex justify-content-center align-items-center gap-1"
                   @onclick="ClickHochwasser">
                    Hochwasserkarte
                    @ExternalLinkIcon
                </a>
            }

            <button class="btn btn-sm btn-outline-primary" @onclick="CopyAddress">
                @(_copyStatus ?? "Adresse kopieren")
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public Property Property { get; set; } = null!;

    /// <summary>WGS-84 coordinates; default((double,double)) means not yet resolved.</summary>
    [Parameter] public (double Lat, double Lon) Coords { get; set; }

    // Marks the buttons that leave the site; the hidden text is for screen readers, which would
    // otherwise get no hint that the link opens elsewhere.
    private static readonly RenderFragment ExternalLinkIcon = __builder =>
    {
        <RadzenIcon Icon="open_in_new" Style="font-size: 1em" />
        <span class="visually-hidden">(externer Link)</span>
    };

    private string GoogleMapsUrl => MapLinks.Google(Property);
    private string OsmUrl => MapLinks.Osm(Property, Coords);
    private string? LaermUrl => MapLinks.Noise(Property.Source);
    private string? HochwasserUrl => MapLinks.Flood(Property.Source, Coords);

    private string DisplayAddress =>
        string.Join(", ",
            new[] { $"{Property.Str} {Property.Hnr}{Property.HnrZus}".Trim(), Property.Plz, Property.Ort }
                .Where(s => !string.IsNullOrWhiteSpace(s)));

    private string? _copyStatus;

    private async Task CopyAddress()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", DisplayAddress);
            _copyStatus = "✓ Kopiert";
        }
        // The Clipboard API only exists in secure contexts (HTTPS) and the browser may deny it;
        // an unhandled exception here would tear down the whole Blazor circuit.
        catch (JSException)
        {
            _copyStatus = "Kopieren nicht möglich";
        }
        // The user left the page mid-call: nothing left to update.
        catch (JSDisconnectedException)
        {
            return;
        }

        StateHasChanged();
        await Task.Delay(1500);
        _copyStatus = null;
        StateHasChanged();
    }

    private void ClickGoogle()     => AppMetrics.RecordOutgoingClick("google");
    private void ClickOsm()        => AppMetrics.RecordOutgoingClick("osm");
    private void ClickLaerm()      => AppMetrics.RecordOutgoingClick("laerm");
    private void ClickHochwasser() => AppMetrics.RecordOutgoingClick("hochwasser");
}
