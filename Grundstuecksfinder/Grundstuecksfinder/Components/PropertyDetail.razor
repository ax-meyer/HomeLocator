@using Grundstuecksfinder.Models
@using Grundstuecksfinder.Services
@inject AppMetrics AppMetrics
@inject IJSRuntime JS

@* Inline expansion panel shown below a clicked result row. *@

<div class="p-3 bg-light border-top">
    <div class="row g-3">

        @* ── Links ────────────────────────────────────────────────────────── *@
        <div class="col d-flex flex-column gap-2">
            <h6 class="mb-2">Karten &amp; Informationen</h6>

            <a href="@GoogleMapsUrl" target="_blank" rel="noopener" class="btn btn-sm btn-outline-secondary"
               @onclick="ClickGoogle">
                Google Maps
            </a>
            <a href="@OsmUrl" target="_blank" rel="noopener" class="btn btn-sm btn-outline-secondary"
               @onclick="ClickOsm">
                OpenStreetMap
            </a>
            @if (LaermUrl is not null)
            {
                <a href="@LaermUrl" target="_blank" rel="noopener" class="btn btn-sm btn-outline-secondary"
                   @onclick="ClickLaerm">
                    Lärmkarte
                </a>
            }
            @if (HochwasserUrl is not null)
            {
                <a href="@HochwasserUrl" target="_blank" rel="noopener" class="btn btn-sm btn-outline-secondary"
                   @onclick="ClickHochwasser">
                    Hochwasserkarte
                </a>
            }

            <button class="btn btn-sm btn-outline-primary" @onclick="CopyAddress">
                @(_copied ? "✓ Kopiert" : "Adresse kopieren")
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public Property Property { get; set; } = null!;

    /// <summary>WGS-84 coordinates; default((double,double)) means not yet resolved.</summary>
    [Parameter] public (double Lat, double Lon) Coords { get; set; }

    private string AddressQuery =>
        Uri.EscapeDataString(
            string.Join(", ",
                new[] { $"{Property.Str} {Property.Hnr}{Property.HnrZus}", Property.Plz, Property.Ort }
                    .Where(s => !string.IsNullOrWhiteSpace(s))));

    // Use FormattableString.Invariant to ensure dots as decimal separators in URLs,
    // regardless of the server's culture (e.g. German locale uses commas).
    private string GoogleMapsUrl => Coords != default
        ? FormattableString.Invariant($"https://www.google.com/maps?q={Coords.Lat},{Coords.Lon}")
        : $"https://www.google.com/maps/search/{AddressQuery}";

    private string OsmUrl => Coords != default
        ? FormattableString.Invariant($"https://www.openstreetmap.org/?mlat={Coords.Lat}&mlon={Coords.Lon}&zoom=17")
        : $"https://www.openstreetmap.org/search?query={AddressQuery}";

    private string? LaermUrl => Property.Source switch
    {
        "nrw" => Coords != default
            ? FormattableString.Invariant($"https://www.umgebungslaerm-kartierung.nrw.de/#map=15/{Coords.Lon}/{Coords.Lat}")
            : "https://www.umgebungslaerm-kartierung.nrw.de/",
        _ => null,
    };

    private string? HochwasserUrl => Property.Source switch
    {
        "nrw" => Coords != default
            ? FormattableString.Invariant($"https://www.hochwasserkarten.nrw.de/?lat={Coords.Lat}&lon={Coords.Lon}&zoom=15")
            : "https://www.hochwasserkarten.nrw.de/",
        _ => null,
    };

    private string DisplayAddress =>
        string.Join(", ",
            new[] { $"{Property.Str} {Property.Hnr}{Property.HnrZus}".Trim(), Property.Plz, Property.Ort }
                .Where(s => !string.IsNullOrWhiteSpace(s)));

    private bool _copied;

    private async Task CopyAddress()
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", DisplayAddress);
        _copied = true;
        StateHasChanged();
        await Task.Delay(1500);
        _copied = false;
        StateHasChanged();
    }

    private void ClickGoogle()     => AppMetrics.RecordOutgoingClick("google");
    private void ClickOsm()        => AppMetrics.RecordOutgoingClick("osm");
    private void ClickLaerm()      => AppMetrics.RecordOutgoingClick("laerm");
    private void ClickHochwasser() => AppMetrics.RecordOutgoingClick("hochwasser");
}
